<shared.PageLayout title="Welcome" hide_chrome={{ true }}>
{# TODO: login-bg.jpg is a placeholder reference image, not rights-cleared —
   swap for owned/licensed art before this ships. See docs/progress.md. #}
<div class="fixed inset-0">
  <img src="{{ static_url('img/valentina1024.png') }}"
       alt=""
       class="w-full h-full object-cover"
       style="object-position: center 25%;">
  <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/25 to-black/55"></div>
</div>

<div class="relative flex flex-col min-h-screen">
  <div class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="flex flex-col items-center text-center max-w-md">
      <div class="w-11 h-0.5 bg-white/85 mb-7"></div>

      <h1 class="font-serif italic text-5xl font-medium text-white mb-3"
          style="text-shadow: 0 4px 24px rgb(0 0 0 / 0.5);">{{ app_name }}</h1>

      <p class="text-white text-sm mb-10">Awake to darkness</p>

      <div class="flex flex-col gap-3">
        {% if oauth_discord_enabled %}
          <a href="{{ url_for('auth.discord_login') }}"
             class="btn bg-[#5865F2] text-white border-[#4752c4]">
            <svg aria-label="Discord logo"
                 width="16"
                 height="16"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 640 640">
