{#def
    character: Character,
    health: Health,
#}
{%- set editable = can_edit_trackers(character) -%}
{%- set post_url = url_for("character_view.health", character_id=character.id) if editable else "" -%}
{%- set damage = health.damage or 0 -%}
{%- set health_actions = tracker_actions_for(character.game_version, "DAMAGE") if editable else [] -%}

<div class="flex flex-col gap-2">
  <h3 class="text-xs uppercase tracking-wider opacity-60">Health</h3>

  {% if health.levels is not none %}
    <ul class="flex flex-col gap-1">
      {% for level in health.levels %}
        <li class="flex items-center gap-2">
          <span class="flex-1">{{ level.name }}</span>
          <character_view.components.TrackerSquare marked={{ level.marked or false }} />
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="inline-flex flex-col gap-0.5">
      {%- for row_start in range(0, health.size, 10) %}
        <span class="inline-flex flex-nowrap gap-0.5 leading-none">
          {%- for i in range(row_start, [row_start + 10, health.size] | min) -%}
            <character_view.components.TrackerSquare marked={{ i < damage }} />
          {%- endfor -%}
        </span>
      {%- endfor %}
    </div>
  {% endif %}

  {% if "damage" in health_actions or "heal" in health_actions %}
    <div class="flex gap-1">
      {% if "damage" in health_actions %}
        <character_view.components.TrackerButton post_url={{ post_url }} vals={{ {"action": "damage"} }} extra_class="btn btn-xs btn-outline btn-error h-7 min-h-7" disabled={{ damage >= health.size }}>Damage</character_view.components.TrackerButton>
      {% endif %}
      {% if "heal" in health_actions %}
        <character_view.components.TrackerButton post_url={{ post_url }} vals={{ {"action": "heal"} }} extra_class="btn btn-xs btn-outline btn-success h-7 min-h-7" disabled={{ damage <= 0 }}>Heal</character_view.components.TrackerButton>
      {% endif %}
    </div>
  {% endif %}
</div>
